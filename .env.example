# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vr_mental_health
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vr_mental_health

# Security
SECRET_KEY=super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
VITE_API_BASE_URL=http://localhost:8000

# AI / LLM (sign up at console.groq.com to get a key)
GROQ_API_KEY=

# Vector store (Qdrant) — docker compose up -d qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks

# Embedding pipeline
# provider: auto (gemini if key set, else local fastembed) | gemini | fastembed
# Get a free Gemini API key at https://aistudio.google.com/apikey
EMBEDDING_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
FASTEMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=100
ENABLE_RERANKING=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
